# Supabase Configuration
# Dapatkan dari Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (untuk seed script dan server-side operations)
# PENTING: Jangan expose key ini di client-side!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Database URL (jika diperlukan untuk tools lain)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
